# Copy to .env and fill in. Never commit .env, and never include it in a zip.

# ── Server ────────────────────────────────────────────────────────────
PORT=3000

# Loopback by default. Only change this if the port is firewalled to your own
# IP, or if you are running behind a reverse proxy that terminates TLS.
BIND_HOST=127.0.0.1

# Shared secret every caller must send as `X-Auth-Token`. Required, min 32 chars.
#   openssl rand -hex 32
AUTH_TOKEN=

# Exact browser origins allowed to call this API. Comma-separated. No wildcards.
# Leave empty if only your scanner (server-to-server) calls it.
ALLOWED_ORIGINS=https://your-site.netlify.app

RATE_LIMIT_PER_MINUTE=30

# Number of reverse proxies in front of this process, for reading the real
# client IP out of X-Forwarded-For. 0 when nothing is in front (the default on
# a VM); 1 behind Caddy or nginx. Set it to 1 with the port directly reachable
# and the rate limiter can be walked past with a forged header.
TRUST_PROXY=0

# ── Safety ────────────────────────────────────────────────────────────
# Must be exactly true or false. A typo is a startup failure, not a silent
# fallback to live trading.
USE_TESTNET=true

# true = compute and log the order, send nothing. Leave true until the plans in
# the log look right. This is the arming switch.
DRY_RUN=true

# ── Sizing and risk ───────────────────────────────────────────────────
# Percent of free margin balance used as NOTIONAL per trade. At 5x leverage a
# value of 5 consumes roughly 1% of the balance as margin.
TRADE_BALANCE_PERCENTAGE=5

# Enforced at order time so sizing is deterministic rather than inheriting
# whatever was last set in the exchange UI.
LEVERAGE=3

# Hard cap on total exposure per symbol, in quote currency. Strongly recommended.
MAX_POSITION_NOTIONAL_QUOTE=500

# Protective stop attached to every entry, as a percent from fill price.
STOP_LOSS_PERCENT=2

# Repeat signals with the same exchange/symbol/side inside this window are
# ignored, so a retrying scanner cannot double your position.
DEDUPE_TTL_MS=60000

# Where the circuit breaker stores its daily baseline. It MUST survive a
# restart: without it, a crash-restart re-baselines at the reduced equity and
# the daily loss limit applies all over again to what is left.
# Leave unset on a VM (defaults to this directory). On Render, mount a
# persistent disk and set this to its mount path, e.g. /var/data
# STATE_DIR=

ORDER_TIMEOUT_MS=20000

# ── Exchange credentials ──────────────────────────────────────────────
# Create keys with trade permission only. No withdrawal permission.
# Restrict them to your server's IP in the exchange dashboard.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Note: ccxt cannot put Weex into sandbox mode. With USE_TESTNET=true the
# server refuses to start while Weex credentials are present, rather than
# trading live funds under a testnet flag.
WEEX_API_KEY=
WEEX_API_SECRET=
